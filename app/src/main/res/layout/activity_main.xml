<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <!-- Main Content Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar / App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_primary"
            app:navigationIcon="@drawable/ic_home"
            app:title="@string/app_name"
            app:titleTextColor="@color/white">

            <ImageView
                android:id="@+id/iv_cart"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:contentDescription="Cart"
                android:src="@drawable/ic_cart"
                app:tint="@color/white" />

        </com.google.android.material.appbar.MaterialToolbar>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Select Restaurant -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Restaurant"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/sp_restaurant"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/btn_dropdown" />

                <!-- Location Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Location"
                        android:src="@drawable/ic_location"
                        app:tint="@color/purple_primary" />

                    <TextView
                        android:id="@+id/tv_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Bandra West, Mumbai"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btn_edit_location"
                        style="@style/Widget.Foodie.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="12dp"
                        android:text="EDIT"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Select Food -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select Food"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/sp_food"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/btn_dropdown" />

                <!-- Food Image Carousel / Preview -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_carousel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Food Image"
                        android:scaleType="centerCrop"
                        android:src="@drawable/margherita_pizza"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded" />

                    <ImageButton
                        android:id="@+id/ib_carousel_left"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ic_home"
                        android:backgroundTint="#80000000"
                        android:contentDescription="Previous"
                        app:tint="@color/white" />

                    <ImageButton
                        android:id="@+id/ib_carousel_right"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/ic_home"
                        android:backgroundTint="#80000000"
                        android:contentDescription="Next"
                        app:tint="@color/white" />

                </RelativeLayout>

                <!-- Our Menu Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Our Menu"
                    android:textColor="@color/purple_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Menu Item 1: Margherita Pizza -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Margherita Pizza"
                        android:scaleType="centerCrop"
                        android:src="@drawable/margherita_pizza"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Margherita Pizza"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="₹249"
                        android:textColor="@color/status_delivered"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_add_margherita"
                        style="@style/Widget.Foodie.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="16dp"
                        android:text="ADD"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Menu Item 2: Farmhouse Pizza -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Farmhouse Pizza"
                        android:scaleType="centerCrop"
                        android:src="@drawable/farmhouse_pizza"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Farmhouse Pizza"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="₹249"
                        android:textColor="@color/status_delivered"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_add_farmhouse"
                        style="@style/Widget.Foodie.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="16dp"
                        android:text="ADD"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Menu Item 3: Cheese Burger -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="Cheese Burger"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cheese_burger"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Cheese Burger"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="₹199"
                        android:textColor="@color/status_delivered"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_add_burger"
                        style="@style/Widget.Foodie.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="16dp"
                        android:text="ADD"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Menu Item 4: White Sauce Pasta -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="White Sauce Pasta"
                        android:scaleType="centerCrop"
                        android:src="@drawable/white_sauce_pasta"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="White Sauce Pasta"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="₹299"
                        android:textColor="@color/status_delivered"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_add_pasta"
                        style="@style/Widget.Foodie.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="16dp"
                        android:text="ADD"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Bottom Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/btn_more_options"
                style="@style/Widget.Foodie.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="MORE OPTIONS"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_visit_website"
                style="@style/Widget.Foodie.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.3"
                android:backgroundTint="@color/status_delivered"
                android:text="VISIT RESTAURANT WEBSITE"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/activity_main_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
